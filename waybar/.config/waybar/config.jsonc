// -*- mode: jsonc -*-
{
  "height": 30,
  "spacing": 8,
  "modules-left": [
    "custom/arch",
    "hyprland/workspaces",
    "hyprland/window",
    "tray"
  ],
  "modules-center": [],
  "modules-right": [
    "bluetooth",
    "pulseaudio",
    //"backlight",
    "temperature",
    "cpu",
    "memory",
    "network",
    "battery",
    "power-profiles-daemon",
    "clock",
    "custom/power"
  ],
  "tray": {
    "spacing": 6,
    "icon-size": 16
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "smooth-scrolling-threshold": 1
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({workspace='e+1'})\"",
    "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({workspace='e-1'})\"",
    "on-click": "activate"
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "separate-outputs": true
  },
  "cpu": {
    "interval": 3,
    "format": " {usage}%",
    "format-alt": " {avg_frequency:.1f}GHz",
    "on-click": "mode",
    "max-length": 10
  },
  "network": {
    "format-wifi": "{ipaddr}",
    "format-alt": "  {essid:2} ({signalStrength}%)",
    "format-ethernet": "{ipaddr}/{cidr} 󰊗",
    "format-disconnected": "󰌙 Disconnected",
    "tooltip-format-wifi": "<b>Network Info</b>\n{essid}\nSignal: {signalStrength}% | {signaldBm} dBm\nFrequency: {frequency} GHz\n\n<b>Connection</b>\nInterface: {ifname}\nIP: {ipaddr}\nGateway: {gwaddr}\nNetmask: {netmask}\nCIDR: {cidr}\n\n<b>Speed</b>\nUp: {bandwidthUpBytes} \nDown: {bandwidthDownBytes} \nTotal: {bandwidthTotalBytes}",
    "tooltip-format-ethernet": "<b>Wired Connection</b>\nInterface: {ifname}\nIP: {ipaddr}\nGateway: {gwaddr}\nNetmask: {netmask}\nCIDR: {cidr}\n\n<b>Speed</b>\nUp: {bandwidthUpBytes} \nDown: {bandwidthDownBytes} \nTotal: {bandwidthTotalBytes}",
    "tooltip-format-disconnected": "󰌙Disconnected",
    "on-click": "mode",
    "on-click-right": "kitty -e nmtui",
    "max-length": 50
  },
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon1/temp5_input",
    "critical-threshold": 80,
    "format": "󰔏 {temperatureC}°C",
    "tooltip": true,
    "tooltip-format": "CPU Temperature: {temperatureC}°C\nCritical: 80°C"
  },
  "memory": {
    "interval": 30,
    "format": " {used:0.1f}G/{total:0.1f}G",
    "format-alt": " {percentage}%"
  },
  "battery": {
    "bat": "BAT1",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}", // On battery
    "format-charging": "⚡ {capacity}%", // Charging
    "format-plugged": " {capacity}%", // Plugged but not charging
    "format-full": "", // Full + plugged
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "max-length": 25,
    "tooltip": true,
    "tooltip-format": "Battery: {capacity}%"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "bluetooth": {
    "format": "{icon}",
    "format-connected": "{icon} {num_connections}",
    "format-alt": "{alias}",
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "{controller_alias}\n\nConnected Devices:\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager &",
    "format-icons": {
      "enabled": "󰂯",
      "disabled": "󰂲"
    }
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d}",
    "on-click": "mode",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weeks": "<span color='#99d1db'><b>W{}</b></span>",
        "weekdays": "<span color='#e5c890'><b>{}</b></span>",
        "today": "<span color='#a6e3a1'><b><u>{}</u></b></span>"
      }
    }
  },
  "pulseaudio": {
    "format": "{icon}{volume}%",
    "format-muted": "󰝟",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "on-click-right": "pavucontrol",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ]
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "Left: Shutdown (confirm)\nMiddle: Reboot (confirm)\nRight: Suspend",
    "on-click": "wofi --dmenu --prompt 'Shutdown?' --width 200 --height 115 --lines 2 <<< $'Yes\\nNo' | grep -q Yes && systemctl poweroff",
    "on-click-middle": "wofi --dmenu --prompt 'Reboot?' --width 200 --height 115 --lines 2 <<< $'Yes\\nNo' | grep -q Yes && systemctl reboot",
    "on-click-right": "systemctl suspend"
  },
  "custom/arch": {
    "format": "<span color='#1793d1'></span>",
    "tooltip": true,
    "tooltip-format": "Arch Linux — Hyprland ⛰️",
    "on-click": "kitty -e sh -c 'btop; exec bash'",
    "on-click-right": "kitty -e sh -c 'fastfetch; exec bash'",
    "on-click-middle": "kitty -e yazi",
    "on-scroll-up": "kitty -e cava"
  }
}
